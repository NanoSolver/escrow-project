# Rename to .env inside the Go project folder (the app loads it automatically).
# Never commit .env.

DATABASE_URL=postgres://escrow:escrow@127.0.0.1:5432/escrow?sslmode=disable

# Local Anvil. For Sepolia use your Alchemy HTTPS URL (free tier).
RPC_URL=http://127.0.0.1:8545

# Private key of the ORACLE address you passed to the contract's constructor.
# Locally: copy "Private Keys (1)" from the anvil output. On Sepolia: a fresh throwaway key
# funded with a little faucet ETH for gas.
ORACLE_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

AI_URL=http://localhost:8000/evaluate
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

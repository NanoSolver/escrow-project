# Export these in your shell. Never commit real keys.

# Create at https://ollama.com/settings/keys
OLLAMA_API_KEY=80e3ac0eba23442abd5698879b4d88ab.cJdOIerbNwL86KlDRP9Kupmy

# Ollama Cloud (default). For a local Ollama server use http://localhost:11434/v1
OLLAMA_BASE_URL=https://ollama.com/v1

# Hosted model name. Ollama retires/adds models, so check what your key can use
# (curl https://ollama.com/api/tags). Smaller/faster option: gpt-oss:20b
LLM_MODEL=gpt-oss:120b

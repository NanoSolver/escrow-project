# Copy this file to .env (ai-service/.env). Never commit real keys.

# OpenRouter provides an OpenAI-compatible API with a free-model router.
# Create an API key in OpenRouter and keep it only in this local .env file.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

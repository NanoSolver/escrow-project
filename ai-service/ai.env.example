# Copy this file to .env (ai-service/.env). Never commit real keys.

# OpenRouter provides an OpenAI-compatible API with a free-model router.
# Create an API key in OpenRouter and keep it only in this local .env file.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free

# Independent reviewers. Keep real API keys only in the ignored local .env file.
# Evaluations fail closed if a reviewer is missing or unavailable.
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

SAMBANOVA_API_KEY=your-sambanova-api-key
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Copy this file to .env (ai-service/.env). Never commit real keys.

# Which LLM judges the work: gemini (default) or ollama
LLM_PROVIDER=gemini

# ── Gemini (free tier) ──
# Create a key in Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Gemini's OpenAI-compatible endpoint (leave as is)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Free-of-charge on the standard tier at the time of writing; override with any model your key can use
LLM_MODEL=gemini-3.8-flash

# ── Ollama Cloud (the previous setup; set LLM_PROVIDER=ollama to go back) ──
# OLLAMA_API_KEY=your-ollama-api-key
# OLLAMA_BASE_URL=https://ollama.com/v1
# With Ollama use e.g. LLM_MODEL=gpt-oss:120b

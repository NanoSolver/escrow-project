lient\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"Refunded\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"freelancer\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"Released\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"freelancer\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint8\",\"name\":\"revisionsUsed\",\"type\":\"uint8\"},{\"indexed\":false,\"internalType\":\"uint8\",\"name\":\"revisionLimit\",\"type\":\"uint8\"}],\"name\":\"RevisionRequested\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"MAX_REVISIONS\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"SETTLEMENT_GRACE\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"acceptJob\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"amount\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"approveByClient\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"client\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"freelancer\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"oracleAddress\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"refundAfterDeadline\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"refundClient\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"releaseFunds\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"requestRevision\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"revisionLimit\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"revisionsUsed\",\"outputs\":[{\"internalType\":\"uint8\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"status\",\"outputs\":[{\"internalType\":\"enum Escrow.Status\",\"name\":\"\",\"type\":\"uint8\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"submissionDeadline\",\"outputs\":[{\"internalType\":\"uint64\",\"name\":\"\",\"type\":\"uint64\"}],\"stateMutability\":\"view\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"title\":\"Escrow\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"SETTLEMENT_GRACE()\":{\"notice\":\"After the deadline the oracle keeps this long to finish a verdict that was already         in flight. Only then may anyone trigger refundAfterDeadline().\"},\"acceptJob()\":{\"notice\":\"Open jobs only: the first caller becomes the freelancer. Only possible while the         escrow is funded (so the freelancer can see the money is locked) and before the deadline.\"},\"approveByClient()\":{\"notice\":\"Client approves AI-approved work and releases the escrowed funds.\"},\"deposit()\":{\"notice\":\"Client locks the agreed amount. Must match `amount` exactly and happen before the deadline.\"},\"refundAfterDeadline()\":{\"notice\":\"Safety valve: if nobody settled the escrow, anyone may return the funds to the client         once the deadline plus the grace period has passed. The funds can only go to the client.\"},\"refundClient()\":{\"notice\":\"Oracle rejects the work for good (no revisions left): return the funds to the client.\"},\"releaseFunds()\":{\"notice\":\"Oracle approves the work: pay the freelancer.\"},\"requestRevision()\":{\"notice\":\"Oracle rejects the work but a revision is still allowed: funds stay locked.\"}},\"notice\":\"One escrow per job. The client locks ETH; only the oracle (the Go backend, acting on         the AI's verdict) can release it to the freelancer, refund the client, or grant the         freelancer another revision. If the oracle goes silent, anyone can refund the client         once the deadline (plus a short grace period) has passed, so funds can never be stuck.         Two ways to name the freelancer:           - assigned: the client passes the freelancer's address when deploying;           - open:     the client passes address(0). Once the job is funded, the first wallet that                       calls acceptJob() becomes the freelancer (one time, final).\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/Escrow.sol\":\"Escrow\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/Escrow.sol\":{\"keccak256\":\"0x0718a1803ee5604a371597b1a25b05911ac3e0cde55d676e1b0279bdabef883d\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://a320eddaa3bfaddc55c7f01fa006919104e51ced443f906ba59d5dc7f68413c4\",\"dweb:/ipfs/QmPM45cZQrSK4WVVv1fXDFwKHqaVFBXQ9nkwGu4TMhCzS7\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address"
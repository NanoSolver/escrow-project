# Copy to .env and fill in. NEVER commit .env (add it to .gitignore).

# Alchemy: Dashboard -> Create app -> Network: Ethereum Sepolia -> copy HTTPS URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# For --verify on Sepolia (free key from etherscan.io)
ETHERSCAN_API_KEY=

# Public addresses only. Private keys go in a Foundry keystore, not here.
ORACLE_ADDRESS=0x0000000000000000000000000000000000000001
FREELANCER_ADDRESS=0x0000000000000000000000000000000000000002
ESCROW_AMOUNT_WEI=10000000000000000
